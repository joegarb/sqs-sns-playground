{
  "name": "sqs-sns-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "deploy": "cdklocal bootstrap && cdklocal deploy --require-approval never",
    "publish": "tsx --env-file-if-exists=.env src/scripts/publish.ts",
    "logs": "tsx --env-file-if-exists=.env src/scripts/logs.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-lambda-powertools/batch": "^2.36.0",
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-cloudformation": "^3.1153.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1153.0",
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/client-sns": "^3.1153.0",
    "@aws-sdk/client-sqs": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-local": "^3.0.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
